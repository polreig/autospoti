# Copia este archivo como ".env" y rellena los valores.
# Nunca subas el ".env" real a git.

SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Contraseña de la app web (opcional pero recomendada si la despliegas online)
APP_PASSWORD=

# Zona horaria para interpretar fechas como "marzo 2022" (por defecto Europe/Madrid)
APP_TIMEZONE=Europe/Madrid

# Segundos mínimos de reproducción para contar una escucha en el historial (por defecto 30)
MIN_PLAY_SECONDS=30

# Opcionales
# HISTORY_DB_PATH=C:\ruta\a\history.db
# SPOTIFY_CACHE={"access_token": "...", ...}   # solo para despliegues sin disco persistente

# Base de datos en la nube (Neon, Supabase...). Si se define, se usa en lugar de SQLite y los
# tokens de Spotify se guardan en ella cifrados (la primera vez se copian de SPOTIFY_CACHE).
# DATABASE_URL=postgresql://usuario:contraseña@host/basedatos?sslmode=require
# TOKEN_ENCRYPTION_KEY=   # opcional; si falta, la clave se deriva de SPOTIPY_CLIENT_SECRET

# Web (login con Spotify). Añade esta URL también en el dashboard de Spotify.
# En Vercel: https://TU-PROYECTO.vercel.app/callback   ·   En local: http://127.0.0.1:8000/callback
# WEB_REDIRECT_URI=https://tu-proyecto.vercel.app/callback
# ALLOWED_SPOTIFY_IDS=tu_id_de_spotify,el_de_tu_novia   # opcional; vacío = cualquiera que Spotify deje entrar
# SESSION_SECRET=   # opcional; firma la cookie de sesión (si falta, se deriva de SPOTIPY_CLIENT_SECRET)
