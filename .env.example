# Copia este archivo como ".env" y rellena los valores.
# Nunca subas el ".env" real a git.

SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Contraseña de la app web (opcional pero recomendada si la despliegas online)
APP_PASSWORD=

# Zona horaria para interpretar fechas como "marzo 2022" (por defecto Europe/Madrid)
APP_TIMEZONE=Europe/Madrid

# Segundos mínimos de reproducción para contar una escucha en el historial (por defecto 30)
MIN_PLAY_SECONDS=30

# Opcionales
# HISTORY_DB_PATH=C:\ruta\a\history.db
# SPOTIFY_CACHE={"access_token": "...", ...}   # solo para despliegues sin disco persistente
